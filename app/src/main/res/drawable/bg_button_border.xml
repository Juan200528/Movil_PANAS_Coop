<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo blanco -->
    <solid android:color="#FFFFFF" />

    <!-- Borde con color #002326 -->
    <stroke
        android:width="6dp"
        android:color="#002326" />

    <!-- Esquinas redondeadas -->
    <corners android:radius="24dp" />

    <!-- Sombra interior simulada mediante padding -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
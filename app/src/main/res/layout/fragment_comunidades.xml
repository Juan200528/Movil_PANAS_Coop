<!-- fragment_comunidades.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- RecyclerView for communities -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewComunidades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <!-- TextView for empty state -->
    <TextView
        android:id="@+id/textViewNoComunidades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay comunidades disponibles"
        android:visibility="gone"
        android:gravity="center"
        android:textSize="16sp" />

    <!-- Chat container -->
    <LinearLayout
        android:id="@+id/container_chat_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChatMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTextChatMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Escribe un mensaje"
                android:inputType="text" />

            <Button
                android:id="@+id/buttonSendChatMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar" />
            <Button
                android:id="@+id/buttonCrearNuevaComunidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear Nueva Comunidad" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título de la sección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="Buscar y Filtar Actividades"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- Cuadro de diálogo de selección -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Campo de búsqueda -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buscar por palabra clave (título o descripcion)"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre actividad..."
                    android:background="@drawable/edit_text_border"
                    android:padding="8dp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección de filtrado por fecha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtrar por fecha"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"/>

        <RadioGroup
            android:id="@+id/rgFechaSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <RadioButton
                android:id="@+id/rbFechaTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:button="@null"
                android:background="@drawable/custom_radio_button"
                android:padding="9dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:textSize="14sp"/>

            <RadioButton
                android:id="@+id/rbFechaProximas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proximas"
                android:button="@null"
                android:background="@drawable/custom_radio_button"
                android:padding="9dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_marginStart="26dp"
                android:includeFontPadding="false"
                android:textSize="14sp"/>

            <RadioButton
                android:id="@+id/rbFechaPasadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pasadas"
                android:button="@null"
                android:background="@drawable/custom_radio_button"
                android:padding="9dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_marginStart="26dp"
                android:includeFontPadding="false"
                android:textSize="14sp"/>

        </RadioGroup>

        <!-- Sección de filtrado por estado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtrar por estado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"/>

        <RadioGroup
            android:id="@+id/rgEstadoSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="6dp">

            <RadioButton
                android:id="@+id/rbEstadoTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:button="@null"
                android:background="@drawable/custom_radio_button"
                android:padding="9dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:includeFontPadding="false"
                android:textSize="14sp"/>

            <RadioButton
                android:id="@+id/rbEstadoPromocionadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promocionadas"
                android:button="@null"
                android:background="@drawable/custom_radio_button"
                android:padding="9dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_marginStart="26dp"
                android:includeFontPadding="false"
                android:textSize="14sp"/>

        </RadioGroup>

        <!-- Botones adicionales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Buscar"
                android:backgroundTint="#0865FE"
                android:layout_marginEnd="8dp"
                android:textColor="@android:color/white"
                android:layout_marginStart="250dp"/>

        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewActividades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
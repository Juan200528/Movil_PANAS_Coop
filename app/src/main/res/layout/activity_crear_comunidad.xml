<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editTextNombreComunidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la comunidad"
        android:inputType="text" />

    <EditText
        android:id="@+id/editTextDescripcionComunidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción de la comunidad"
        android:inputType="text" />

    <Button
        android:id="@+id/buttonCrearComunidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear Comunidad" />
</LinearLayout>